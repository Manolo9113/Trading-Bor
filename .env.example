# ============================================================
# Trading Bot – Umgebungsvariablen
# cp .env.example .env  und dann ausfuellen
# NIEMALS .env in Git committen!
# ============================================================

# ── Alpaca Markets (US-Aktien) ───────────────────────────────
# Paper-Trading Keys: https://app.alpaca.markets/paper-dashboard
# Live-Trading Keys:  https://app.alpaca.markets/live-dashboard
ALPACA_API_KEY=dein_alpaca_api_key
ALPACA_SECRET_KEY=dein_alpaca_secret_key

# ── MB-AktienScreener API ────────────────────────────────────
# Railway-URL deines Screener-Services (falls vorhanden)
SCREENER_API_URL=https://dein-screener.up.railway.app
SCREENER_API_KEY=

# ── Telegram Benachrichtigungen (optional) ───────────────────
# Bot erstellen: @BotFather auf Telegram
# Chat-ID: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Crypto Exchange (CCXT, optional) ─────────────────────────
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
